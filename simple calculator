print("=========== SIMPLE CALCULATOR ===========")

num1 = int(input("Enter the number: "))
operator = input("Enter the operator (+, -, *, /): ")
num2 = int(input("Enter the number: "))

if operator == "+":
    print(num1 + num2)

elif operator == "-":
    print(num1 - num2)

elif operator == "*":
    print(num1 * num2)

elif operator == "/":
    if num2 == 0:
        print("Cannot divide by zero")
    else:
        print(num1 / num2)

else:
    print("Invalid operator")